# Copy to .env on your own Windows computer. NEVER commit .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bernini-rv2v
# Must point to the exact authenticated Vast worker /generate/sync URL.
# Obtain this from your deployed Vast endpoint's routing/API configuration.
BERNINI_VAST_GENERATE_URL=
VAST_API_KEY=
# Absolute Windows path to your ComfyUI API-format workflow JSON
BERNINI_WORKFLOW_PATH=
